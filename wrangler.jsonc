{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eyva-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "MAIL_TO": "valeriahaman@gmail.com"
  },
  "kv_namespaces": [
    { "binding": "WAITLIST", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "send_email": [
    { "name": "MAIL", "destination_address": "valeriahaman@gmail.com" }
  ],
  "observability": { "enabled": true }
}
